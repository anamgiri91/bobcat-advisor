# LLM provider — Gemini or Groq, both via their OpenAI-compatible APIs.
# LLM_PROVIDER=auto picks Gemini when GEMINI_API_KEY is set, else Groq.
# Without any key the app still runs: routing falls back to rules and answers
# are extractive (retrieved quotes + computed stats) instead of LLM-written.
GEMINI_API_KEY=your_gemini_key_here      # https://aistudio.google.com/apikey
# GROQ_API_KEY=your_groq_key_here        # https://console.groq.com
# LLM_PROVIDER=auto

# Models. Availability depends on YOUR key, not the public model list (Gemini
# lists 2.5 models that 404 for new keys) — verify with
# GET /api/health?deep=true after changing them. Provider defaults:
#   gemini: gemini-3.6-flash / fallback gemini-3.5-flash-lite
#   groq:   openai/gpt-oss-120b / fallback openai/gpt-oss-20b
# LLM_MODEL=                     # synthesis
# LLM_FALLBACK_MODEL=            # on 404 / 408 / 429 / 5xx / JSON-validation failure
# LLM_FAST_MODEL=                # router + verifier
# LLM_REASONING_EFFORT=low       # thinking budget for synthesis
# LLM_FAST_REASONING_EFFORT=     # router/verifier (gemini default: minimal)
# LLM_TIMEOUT_S=30
# LLM_FAST_TIMEOUT_S=10          # router/verifier deadline (they have deterministic fallbacks)

# Postgres connection string
# Local docker-compose default shown below; Render/production will inject
# its own DATABASE_URL.
DATABASE_URL=postgresql+psycopg2://bobcat:bobcat@localhost:5432/bobcat_advisor

# ChromaDB persistence directory (vector store — unrelated to Postgres)
CHROMA_DB_PATH=data/chroma_db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Pipeline knobs (defaults chosen with the eval harness — see docs/EVALUATION.md)
# RERANKER_ENABLED=false          # +~100MB RAM; don't enable on 512MB instances
# VERIFIER_ENABLED=true
# MAX_LLM_CALLS_PER_REQUEST=5
# RATE_LIMIT_PER_MINUTE=20

# Secrets: instead of putting keys here, you can use NAME_FILE=/path, secret
# files in /etc/secrets or /run/secrets, or a secrets manager:
# SECRETS_BACKEND=aws            # or gcp (with GCP_PROJECT); needs boto3 / google-cloud-secret-manager
# SECRETS_PREFIX=bobcat/

# Observability (OpenTelemetry). Unset endpoint = no export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Basic ...   # keep in a secret file
# LLM_PRICES={"<model-id>": [<usd_per_1M_input>, <usd_per_1M_output>]}   # from the provider's pricing page
# Career paths: optional web search for outside courses (else the curated list).
# SEARCH_PROVIDER=brave
# BRAVE_API_KEY=                 # secret: prefer a Secret File or secrets manager
# CAREER_MAX_PAGES=24            # links the link checker may open per request
# ENVIRONMENT=development
# TRUSTED_PROXY_HOPS=1

# Retrieval: hybrid (default), or bm25 when the embedding model isn't available
# RETRIEVAL_MODE=hybrid
# Timetable solver: auto (OR-Tools if installed), ortools, or search (saves ~85MB RAM)
# TIMETABLE_SOLVER=auto
# Knowledge-base pages fetched longer ago than this aren't used to answer
# KB_MAX_AGE_DAYS=400

# Course-recommendation pipeline (web research on the live TXST catalog)
# WEB_BROWSING_ENABLED=true
# CATALOG_BASE_URL=https://mycatalog.txstate.edu
# WEB_ALLOWED_DOMAINS=txstate.edu,txst.edu
# WEB_MAX_PAGES=10
# WEB_MAX_COURSE_LOOKUPS=6
# WEB_TIMEOUT_S=10
# WEB_CACHE_TTL_S=21600
