      "max_depth": 2,
      "refresh_days": 30,
      "catalog_year": false
    },
    {
      "id": "syllabi",
      "kind": "syllabus",
      "name": "TXST public course syllabi (HB 2504)",
      "seeds": ["https://hb2504.txst.edu/", "https://hb2504.txstate.edu/"],
      "follow": ["syllab", "course", "computer-science", "cs-", "/cs/", "subject=cs", ".pdf"],
