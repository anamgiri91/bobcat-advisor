# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Virtual environments
venv/
.venv/

# Environment variables — never commit real secrets (GEMINI_API_KEY, GROQ_API_KEY, DATABASE_URL)
.env
backend/.env
frontend/.env
# .env.example files ARE tracked — they contain no secrets, just placeholders

# Node / frontend build output
node_modules/
frontend/dist/
npm-debug.log*

# Vector index + chunk data
# Comment these two lines OUT if you want the prebuilt ChromaDB index and
# chunks.jsonl committed (recommended here — it's ~4MB and lets anyone who
# clones the repo run it immediately without `build_index.sh`).
# backend/data/chroma_db/
# backend/data/chunks.jsonl

# Sentence-transformers model cache (re-downloaded at runtime, don't commit)
backend/.models/

# Docker
*.pid

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
# Local artifacts
.models/
.fastembed/
.pytest_cache/
.ruff_cache/
*.db
backend/evals/results/
